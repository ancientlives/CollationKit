  "_frenchSourcesDownloaded": "The French originals for the 4 corpus works are downloaded into raw/ (2026-07-24): pg5097 (Vingt mille lieues), pg38674 (De la terre a la lune), pg4791 (Voyage au centre de la Terre — Gallica OCR w/ FR+EN preface), pg14287 (L'ile mysterieuse). scripts/build_corpus.sh fetches them and has a commented-out French-witness section (fr- sigla) ready to uncomment for French<->English or French-French collation. The cleaner preserves accents. FR 'Le Tour du monde' id still unresolved (20973 404s).",
  "_schema": {
    "work": "slug (matches corpus/verne/<work>/ when held)",
    "titleEn": "common English title",
    "titleFr": "original French title",
    "frenchFirst": "first French publication year (verified)",
    "frenchRevised": "year of a revised French state, if any (a French-French collation seam)",
    "frenchPublisher": "publisher of the French first edition",
    "frenchPg": "Gutenberg id of a public-domain French text, or null",
    "inCorpus": "true if cleaned witnesses exist under corpus/verne/<work>/",
    "translations": [
      {
        "translator": "name, or 'anonymous'",
        "year": "first English publication year",
        "publisher": "publisher | null (+ verify)",
        "pg": "Gutenberg id if public-domain text exists | null",
        "held": "true if a cleaned witness of THIS translation is in the corpus",
        "publicDomain": "true|false|null — US public-domain status",
        "note": "collation-relevant character (abridged? rewrite? faithful?)",
        "verify": "what still needs sourcing, if anything"
      }
    ]
  },

